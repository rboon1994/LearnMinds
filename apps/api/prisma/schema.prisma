datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
  STUDENT
}

enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TenantPackage {
  FREE
  PRO
  ENTERPRISE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum VideoType {
  UPLOAD
  EXTERNAL_LINK
}

enum AiAgentModelStatus {
  ACTIVE
  INACTIVE
}

enum KnowledgeBaseFileStatus {
  PENDING
  SYNCED
  FAILED
}

enum AgentMessageRole {
  USER
  ASSISTANT
}

enum AgentAttachmentType {
  DOCUMENT
  IMAGE
}

model Tenant {
  id           String         @id @default(cuid())
  name         String
  package      TenantPackage  @default(FREE)
  status       Status         @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  users        User[]
  departments  Department[]
  courses      Course[]
  enrollments  Enrollment[]
  courseSeries CourseSeries[]
  aiAgents     AiAgent[]
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  password           String
  fullName           String
  phoneCountryCode   String?
  phoneNo            String?
  role               Role                @default(USER)
  status             Status              @default(ACTIVE)
  mustChangePassword Boolean             @default(false)
  jobTitle           String?
  lastSignInAt       DateTime?
  tenantId           String?
  tenant             Tenant?             @relation(fields: [tenantId], references: [id])
  departmentId       String?
  department         Department?         @relation(fields: [departmentId], references: [id])
  studentId          String?             @unique
  student            Student?            @relation(fields: [studentId], references: [id])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  coursesCreated     Course[]
  enrollmentsGranted Enrollment[]
  agentConversations AgentConversation[]
  lessonViews        LessonView[]
}

// Thin satellite for the Student "flavor" of a User row (role: STUDENT, tenantId: null) —
// holds only genuinely Student-specific data as it comes up (none needed yet). Kept separate
// from User rather than adding nullable Student columns there, per explicit decision.
model Student {
  id          String       @id @default(cuid())
  user        User?
  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Department {
  id         String   @id @default(cuid())
  name       String
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  users      User[]
  navItemIds String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([name, tenantId])
}

model NavItem {
  id               String          @id @default(cuid())
  name             String
  href             String          @unique
  icon             String
  order            Int             @default(0)
  isSystem         Boolean         @default(false)
  isAdminNav       Boolean         @default(false)
  isAllDepts       Boolean         @default(true)
  isStudentVisible Boolean         @default(false)
  packages         TenantPackage[]
  status           Status          @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model AdminFeature {
  id          String          @id @default(cuid())
  name        String
  key         String          @unique
  description String?
  order       Int             @default(0)
  isSystem    Boolean         @default(false)
  packages    TenantPackage[]
  status      Status          @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// Groups different date-instances of the "same" recurring course (e.g. re-run cohorts).
// Enrollment grants access at this level — enrolling in a series unlocks every Course under it.
model CourseSeries {
  id          String       @id @default(cuid())
  name        String
  tenantId    String?
  tenant      Tenant?      @relation(fields: [tenantId], references: [id])
  courses     Course[]
  enrollments Enrollment[]
  agents      AiAgent[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Course {
  id              String        @id @default(cuid())
  title           String
  description     String?
  thumbnail       String?
  startDate       DateTime?
  endDate         DateTime?
  status          ContentStatus @default(DRAFT)
  tenantId        String?
  tenant          Tenant?       @relation(fields: [tenantId], references: [id])
  seriesId        String?
  series          CourseSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  speakers        Speaker[]
  // Powers the "Contact via WhatsApp" button on /learn's locked-course modal — Super-Admin-only,
  // same as Series/Speaker. Button is hidden entirely on /learn when whatsappNumber is unset.
  whatsappNumber  String?
  whatsappMessage String?
  createdById     String?
  createdBy       User?         @relation(fields: [createdById], references: [id])
  lessons         Lesson[]
  files           CourseFile[]
  enrollments     Enrollment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tenantId])
  @@index([seriesId])
}

model Speaker {
  id            String    @id @default(cuid())
  name          String
  title         String?
  description   String?
  thumbnail     String?
  courses       Course[]
  agentsCreated AiAgent[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Lesson {
  id              String        @id @default(cuid())
  title           String
  courseId        String
  course          Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order           Int           @default(0)
  status          ContentStatus @default(DRAFT)
  videoType       VideoType
  videoUrl        String?
  durationSeconds Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  views           LessonView[]

  @@index([courseId])
}

// Records that a user actually opened/watched a lesson's video (vs. Enrollment, which only
// proves access was granted). viewCount/lastViewedAt are only ever moved by the throttled
// upsert in LessonsService — lastViewedAt is intentionally NOT @updatedAt so nothing else
// can silently bump it and bypass that throttle.
model LessonView {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId      String
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  viewCount     Int      @default(1)
  firstViewedAt DateTime @default(now()) @db.Timestamptz(3)
  lastViewedAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, lessonId])
  @@index([userId, lastViewedAt])
  @@index([lessonId])
}

model CourseFile {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([courseId])
}

// Access-grant record only (no payment/order fields this round). Targets either a CourseSeries
// (enrolling grants access to every Course under that series, so a newly-added re-run of the same
// series is immediately visible without a new Enrollment) or a single standalone Course, directly
// and independently of that course's series enrollment. Exactly one of studentId/tenantId, and
// exactly one of seriesId/courseId, must be set — enforced in EnrollmentsService AND backstopped by
// DB-level CHECK constraints (chk_enrollment_assignee/chk_enrollment_target, added by hand in the
// migration since Prisma's schema DSL can't express CHECK constraints declaratively).
model Enrollment {
  id           String        @id @default(cuid())
  seriesId     String?
  series       CourseSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  courseId     String?
  course       Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  agentId      String?
  agent        AiAgent?      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  studentId    String?
  student      Student?      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenantId     String?
  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrolledById String
  enrolledBy   User          @relation(fields: [enrolledById], references: [id])
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())

  @@unique([seriesId, studentId])
  @@unique([seriesId, tenantId])
  @@unique([courseId, studentId])
  @@unique([courseId, tenantId])
  @@unique([agentId, studentId])
  @@unique([agentId, tenantId])
  @@index([courseId])
  @@index([agentId])
  @@index([studentId])
  @@index([tenantId])
  @@index([seriesId])
  @@index([studentId, expiresAt])
  @@index([tenantId, expiresAt])
}

// Platform-wide LLM model catalog (pricing/limits), SUPER_ADMIN-managed like CourseSeries.
// Exactly one row may have isDefault: true at any time — enforced in AiAgentModelsService.
model AiAgentModel {
  id               String             @id @default(cuid())
  modelId          String             @unique
  displayName      String
  maxTokenLimit    Int
  inputTokenPrice  Decimal            @db.Decimal(10, 6)
  outputTokenPrice Decimal            @db.Decimal(10, 6)
  temperature      Float              @default(0.7)
  isDefault        Boolean            @default(false)
  status           AiAgentModelStatus @default(ACTIVE)
  agents           AiAgent[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model AiAgent {
  id              String              @id @default(cuid())
  name            String
  description     String?
  systemPrompt    String              @db.Text
  instructions    String?             @db.Text
  thumbnail       String?
  tenantId        String?
  tenant          Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  modelId         String
  model           AiAgentModel        @relation(fields: [modelId], references: [id])
  seriesId        String?
  series          CourseSeries?       @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  creatorId       String?
  creator         Speaker?            @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  status          ContentStatus       @default(DRAFT)
  knowledgeBaseId String?
  knowledgeBase   KnowledgeBase?      @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  conversations   AgentConversation[]
  enrollments     Enrollment[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([tenantId])
  @@index([seriesId])
  @@index([modelId])
  @@index([creatorId])
  @@index([knowledgeBaseId])
}

// Standalone, reusable document set + OpenAI Vector Store — many AiAgents can attach the same
// KnowledgeBase (see AiAgent.knowledgeBaseId), so a shared reference doc set is uploaded and
// vectorized once rather than duplicated per agent.
model KnowledgeBase {
  id            String              @id @default(cuid())
  name          String
  description   String?
  vectorStoreId String?
  files         KnowledgeBaseFile[]
  agents        AiAgent[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model KnowledgeBaseFile {
  id              String                  @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase           @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  fileName        String
  fileUrl         String
  mimeType        String
  sizeBytes       Int
  openaiFileId    String?
  status          KnowledgeBaseFileStatus @default(PENDING)
  createdAt       DateTime                @default(now())

  @@index([knowledgeBaseId])
}

// No uniqueness on (agentId, userId) — a user can open multiple separate threads with the same agent.
model AgentConversation {
  id            String         @id @default(cuid())
  agentId       String
  agent         AiAgent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String?
  // Lazily created the first time a document is attached to a message in this conversation —
  // isolated per-conversation so an attached file never leaks into a different thread (even a
  // New Chat with the same agent), and never touches the shared AiAgent-level KnowledgeBase.
  vectorStoreId String?
  messages      AgentMessage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([agentId, userId])
  @@index([userId])
}

model AgentMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AgentMessageRole
  content        String            @db.Text
  attachments    AgentAttachment[]
  // Only ever set on ASSISTANT messages — the OpenAI completion call is what has a token/cost
  // cost; the USER message that triggered it doesn't. costUsd is computed once at send time from
  // AiAgentModel's per-1M-token prices, not recomputed later if those prices change afterward.
  inputTokens    Int?
  outputTokens   Int?
  // Number of file_search tool invocations OpenAI billed for this turn ($2.50/1000 calls,
  // hardcoded in agent-chat.service.ts — not a configurable AiAgentModel price like token
  // costs, since it's a flat platform-wide rate, not model-specific). Already folded into costUsd.
  fileSearchCalls Int?
  costUsd        Decimal?          @db.Decimal(10, 6)
  createdAt      DateTime          @default(now())

  @@index([conversationId])
}

// Documents sync to the conversation's vectorStoreId for file_search grounding (openaiFileId
// set); images never go through the Files API at all — they're read from local disk and sent
// inline as vision input only on the turn they're uploaded (openaiFileId stays null).
model AgentAttachment {
  id           String              @id @default(cuid())
  messageId    String
  message      AgentMessage        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type         AgentAttachmentType
  fileName     String
  fileUrl      String
  mimeType     String
  sizeBytes    Int
  openaiFileId String?
  createdAt    DateTime            @default(now())

  @@index([messageId])
}
