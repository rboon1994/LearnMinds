datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
  STUDENT
}

enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TenantPackage {
  FREE
  PRO
  ENTERPRISE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum VideoType {
  UPLOAD
  EXTERNAL_LINK
}

model Tenant {
  id           String         @id @default(cuid())
  name         String
  package      TenantPackage  @default(FREE)
  status       Status         @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  users        User[]
  departments  Department[]
  courses      Course[]
  enrollments  Enrollment[]
  courseSeries CourseSeries[]
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  password           String
  fullName           String
  phoneCountryCode   String?
  phoneNo            String?
  role               Role         @default(USER)
  status             Status       @default(ACTIVE)
  mustChangePassword Boolean      @default(false)
  jobTitle           String?
  lastSignInAt       DateTime?
  tenantId           String?
  tenant             Tenant?      @relation(fields: [tenantId], references: [id])
  departmentId       String?
  department         Department?  @relation(fields: [departmentId], references: [id])
  studentId          String?      @unique
  student            Student?     @relation(fields: [studentId], references: [id])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  coursesCreated     Course[]
  enrollmentsGranted Enrollment[]
}

// Thin satellite for the Student "flavor" of a User row (role: STUDENT, tenantId: null) —
// holds only genuinely Student-specific data as it comes up (none needed yet). Kept separate
// from User rather than adding nullable Student columns there, per explicit decision.
model Student {
  id          String       @id @default(cuid())
  user        User?
  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Department {
  id         String   @id @default(cuid())
  name       String
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  users      User[]
  navItemIds String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([name, tenantId])
}

model NavItem {
  id               String          @id @default(cuid())
  name             String
  href             String          @unique
  icon             String
  order            Int             @default(0)
  isSystem         Boolean         @default(false)
  isAdminNav       Boolean         @default(false)
  isAllDepts       Boolean         @default(true)
  isStudentVisible Boolean         @default(false)
  packages         TenantPackage[]
  status           Status          @default(ACTIVE)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model AdminFeature {
  id          String          @id @default(cuid())
  name        String
  key         String          @unique
  description String?
  order       Int             @default(0)
  isSystem    Boolean         @default(false)
  packages    TenantPackage[]
  status      Status          @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// Groups different date-instances of the "same" recurring course (e.g. re-run cohorts).
// Enrollment grants access at this level — enrolling in a series unlocks every Course under it.
model CourseSeries {
  id          String       @id @default(cuid())
  name        String
  tenantId    String?
  tenant      Tenant?      @relation(fields: [tenantId], references: [id])
  courses     Course[]
  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Course {
  id          String        @id @default(cuid())
  title       String
  description String?
  thumbnail   String?
  startDate   DateTime?
  endDate     DateTime?
  status      ContentStatus @default(DRAFT)
  tenantId    String?
  tenant      Tenant?       @relation(fields: [tenantId], references: [id])
  seriesId    String?
  series      CourseSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  speakers    Speaker[]
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id])
  lessons     Lesson[]
  files       CourseFile[]
  enrollments Enrollment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([tenantId])
  @@index([seriesId])
}

model Speaker {
  id          String   @id @default(cuid())
  name        String
  title       String?
  description String?
  thumbnail   String?
  courses     Course[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lesson {
  id              String        @id @default(cuid())
  title           String
  courseId        String
  course          Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order           Int           @default(0)
  status          ContentStatus @default(DRAFT)
  videoType       VideoType
  videoUrl        String?
  durationSeconds Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([courseId])
}

model CourseFile {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([courseId])
}

// Access-grant record only (no payment/order fields this round). Targets either a CourseSeries
// (enrolling grants access to every Course under that series, so a newly-added re-run of the same
// series is immediately visible without a new Enrollment) or a single standalone Course, directly
// and independently of that course's series enrollment. Exactly one of studentId/tenantId, and
// exactly one of seriesId/courseId, must be set — enforced in EnrollmentsService AND backstopped by
// DB-level CHECK constraints (chk_enrollment_assignee/chk_enrollment_target, added by hand in the
// migration since Prisma's schema DSL can't express CHECK constraints declaratively).
model Enrollment {
  id           String        @id @default(cuid())
  seriesId     String?
  series       CourseSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  courseId     String?
  course       Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId    String?
  student      Student?      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenantId     String?
  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrolledById String
  enrolledBy   User          @relation(fields: [enrolledById], references: [id])
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())

  @@unique([seriesId, studentId])
  @@unique([seriesId, tenantId])
  @@unique([courseId, studentId])
  @@unique([courseId, tenantId])
  @@index([courseId])
  @@index([studentId])
  @@index([tenantId])
  @@index([seriesId])
}
